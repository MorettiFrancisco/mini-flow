# Copiar a .env y completar las keys de Langfuse.
#   cp .env.example .env

# ---------------------------------------------------------------- Langfuse
# Instancia self-hosted que ya corre aparte (imágenes :4). Las keys salen de
# tu UI -> Settings -> API Keys.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# Desde dentro de los contenedores de este compose. Si corrés la app en el host
# con `uv run`, usá http://localhost:3000.
LANGFUSE_HOST=http://host.docker.internal:3000

LANGFUSE_TRACING_ENVIRONMENT=local

# Kill switch: apaga toda la instrumentación y usa los prompts hardcodeados de
# app/prompts.py. Útil para iterar sin Langfuse levantado.
# LANGFUSE_ENABLED=false

# ------------------------------------------------------------------ Ollama
# Estos valores son para correr en el host; dentro de compose los sobreescribe
# el bloque environment de docker-compose.yml (http://ollama:11434).
OLLAMA_BASE_URL=http://localhost:11434

# qwen2.5:3b (~2 GB) por defecto: en CPU un 7B cuesta 15-25 s por generación y
# hay 3 generaciones por request. Para más calidad: qwen2.5:7b-instruct.
CHAT_MODEL=qwen2.5:3b
EMBED_MODEL=nomic-embed-text

# El default de Ollama es chico y trunca el prompt en silencio.
NUM_CTX=8192
OLLAMA_KEEP_ALIVE=30m

# ------------------------------------------------------------------ Chroma
CHROMA_HOST=localhost
CHROMA_PORT=8000
# La dimensión va en el nombre: cambiar EMBED_MODEL debe crear una colección
# nueva, no corromper la vieja (nomic-embed-text es 768-d).
CHROMA_COLLECTION=docs_nomic_768

# ------------------------------------------------------------------- Grafo
TOP_K=5
MIN_RELEVANT=2
MAX_REWRITES=2
RECURSION_LIMIT=15

# Tope de requests en vuelo. Ollama en CPU serializa: sin esto, 10 requests HTTP
# encolan decenas de inferencias y todas dan timeout.
MAX_CONCURRENCY=3

# --------------------------------------------------------- Prompts / ingesta
PROMPT_LABEL=production
PROMPT_CACHE_TTL=300
CHUNK_SIZE=800
CHUNK_OVERLAP=120
# INGEST_FORCE=1
